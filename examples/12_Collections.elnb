    "languageId": "e-lang",
    "content": "// ============================================\n// Test 12: Collections - Lists and Indexing\n// ============================================\n// Tests: list expressions, indexing,\n// member access, list operations\n\n// Empty list\nconst empty_list = []\nprint empty_list\n\n// List with numbers\nconst numbers = [1, 2, 3, 4, 5]\nprint numbers\n\n// List with strings\nconst words = [\"apple\", \"banana\", \"cherry\", \"date\"]\nprint words\n\n// List with booleans\nconst flags = [true, false, true, true, false]\nprint flags\n\n// List with mixed expressions\nconst values = [10 + 5, 20 - 3, 15 * 2, 100 / 4]\nprint values\n\n// List with decimals\nconst decimals = [1.5, 2.7, 3.14159, 4.2, 5.99]\nprint decimals\n\n// List with null values\nconst mixed = [1, null, 3, null, 5]\nprint mixed\n\n// Index access with integer\nconst my_list = [10, 20, 30, 40, 50]\nconst first = my_list[0]\nconst second = my_list[1]\nconst third = my_list[2]\n\nprint first\nprint second\nprint third\n\n// Index access with expressions\nconst idx = 2\nconst value_at_idx = my_list[idx]\nprint value_at_idx\n\n// List of model objects\nmodel Point {\n    x: number,\n    y: number\n}\n\nconst points = [\n    { x: 0, y: 0 },\n    { x: 5, y: 10 },\n    { x: 10, y: 20 }\n]\n\nprint points\n\n// Accessing nested model members\nconst first_point = points[0]\nprint first_point.x\nprint first_point.y\n\n// List of lists (nested lists)\nconst matrix = [\n    [1, 2, 3],\n    [4, 5, 6],\n    [7, 8, 9]\n]\n\nprint matrix\n\n// Accessing nested list elements\nconst matrix_element = matrix[1][2]\nprint matrix_element\n\n// List in formulas\nformula get_first(items: number list) : number {\n    return items[0]\n}\n\nformula get_length(items: number list) : number {\n    return 5\n}\n\nconst nums = [100, 200, 300, 400, 500]\nprint get_first(nums)\n\n// List modifications with variables\nvar dynamic_list = [1, 2, 3]\nprint dynamic_list\n\n// Index with calculation\nconst calc_idx = 1 + 1\nconst element = my_list[calc_idx]\nprint element\n"
  }
]