// ============================================
// Test 02: Arithmetic Operations
// ============================================
// Tests: +, -, *, /, ^ operators, 
// operator precedence, parentheses

const a = 10
const b = 3
const c = 2

// Addition
print a + b

// Subtraction
print a - b

// Multiplication
print a * b

// Division
print a / b

// Exponentiation
print a ^ c
print 2 ^ 10

// Negative numbers
print -a
print -5

// Complex expressions with precedence
print a + b * c
print (a + b) * c

// Chained operations
print a + b - c + 5
print a * b / c

// Operations with decimals
const x = 7.5
const y = 2.5
print x + y
print x * y
print x / y
print x ^ 2

// Mixed integer and decimal
const int_val = 5
const dec_val = 2.5
print int_val + dec_val
print int_val * dec_val
print int_val ^ dec_val

// Post-unary operations
var counter = 5
print counter++
print counter
print counter--
print counter
