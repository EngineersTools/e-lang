// var myNumberVar = null;

myBooleanVar = true
// myTextVar = "Hello World"
// myNumberVar = 10

print myBooleanVar;

dimension Distance {
    unit m: meter
    unit km: kilometer

    conversion km->m: (val: km): m => val * 1000
}

const length: Distance = 10 m
// const width: Distance = null

print length
// print width

model MyModel {
    modelText: text
    modelNumber: number
    modelBoolean: boolean
}

const myModel: MyModel = null

print myModel