    "content": "// ============================================\n// Test 18: Edge Cases and Complex Combinations\n// ============================================\n// Tests: complex nested expressions,\n// edge cases, unusual but valid combinations\n\n// Empty model\nconst empty_model = {}\nprint empty_model\n\n// Deeply nested expressions\nconst deep_calc = ((((5 + 3) * 2) - 4) / 2) ^ 2\nprint deep_calc\n\n// Comparison chains\nconst chain = (5 < 10) and (10 < 20) and (20 < 100)\nprint chain\n\n// Or chains\nconst or_chain = (1 > 10) or (5 > 2) or (3 > 8)\nprint or_chain\n\n// Complex boolean expressions\nconst bool_expr = (true and false) or (true and true) or (false or true)\nprint bool_expr\n\n// Negative numbers in expressions\nconst neg1 = -5 + 3\nconst neg2 = -10 * -2\nconst neg3 = -(5 + 3)\nprint neg1\nprint neg2\nprint neg3\n\n// Double negative\nconst double_neg = - -5\nprint double_neg\n\n// Not chains (should work)\nconst not_chain = not not true\nprint not_chain\n\n// Complex list expressions\nconst empty_lists = [[], [], []]\nprint empty_lists\n\nconst list_of_lists_of_lists = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]\nprint list_of_lists_of_lists\n\n// Model with null members\nconst model_with_nulls = {\n    field1: null,\n    field2: null,\n    field3: 42\n}\nprint model_with_nulls\n\n// Lambda with no body parameters\nconst no_params = () => 42\nprint no_params()\n\n// Lambda with just a block\nconst lambda_block = (x: number) => {\n    var result = x * 2\n    return result\n}\nprint lambda_block(5)\n\n// Multiple lambdas in list\nconst lambda_list = [\n    (x: number) => x + 1,\n    (x: number) => x * 2,\n    (x: number) => x ^ 2\n]\nprint lambda_list[0](5)\n\n// For loop with formula in step\nformula get_step() : number {\n    return 2\n}\n\nfor (var i: number = 0 from 0 to 10 step get_step()) {\n    print i\n}\n\n// Match with complex return values\nconst match_result = match 5 {\n    1 => 10\n    2 => 20\n    5 => {\n        var calc = 5 * 5\n        return calc\n    }\n    default => 0\n}\nprint match_result\n\n// If statement as expression in assignment\nvar assigned_if = (() => {\n    if (true) {\n        return 42\n    } else {\n        return 0\n    }\n})()\n\n// Ternary-like pattern with match\nconst ternary_pattern = match true {\n    true => \"yes\"\n    false => \"no\"\n}\nprint ternary_pattern\n\n// Empty for loop\nprint \"Empty for loop:\"\nfor (var i: number = 5 from 5 to 5) {\n    print i\n}\n\n// For loop with same start and end\nfor (var i: number = 10 from 10 to 10) {\n    print \"Single iteration\"\n    print i\n}\n\n// Assignment in if condition\nconst assignment_cond = 10\nif (assignment_cond == 10) {\n    print \"Assignment works in conditions\"\n}\n\n// Complex model with lambdas\nmodel Config {\n    name: text,\n    value: number,\n    processor: (number) => number\n}\n\nconst config_with_lambda = {\n    name: \"test\",\n    value: 42,\n    processor: (x: number) => x * 2\n}\nprint config_with_lambda\n\n// Post-unary on formula result\nformula get_value() : number {\n    return 5\n}\n\nvar post_result = get_value() + 1\nprint post_result\n\n// Post-unary chains (if supported)\nvar counter = 10\nvar a = counter++\nvar b = counter--\nprint a\nprint b\nprint counter\n\n// Multiple assignments\nvar x = 5\nx = 10\nx = 15\nx = 20\nprint x\n\n// Assignment with expression\nvar y = 0\ny = 5 + 3\ny = y * 2\ny = y - 4\nprint y\n\n// Formula with all optional parameters\nformula all_optional(a?: number, b?: number, c?: number) : number {\n    return 10\n}\nprint all_optional()\nprint all_optional(1)\nprint all_optional(1, 2)\nprint all_optional(1, 2, 3)\n\n// List with operations\nconst list_ops = [1 + 1, 2 * 3, 4 ^ 2, 10 / 2]\nprint list_ops\n\n// Index with complex expression\nconst idx_calc = [10, 20, 30, 40, 50]\nconst index = 1 + 1\nprint idx_calc[index]\n\n// Member access chain\nmodel Level3 {\n    value: number\n}\n\nmodel Level2 {\n    level3: Level3\n}\n\nmodel Level1 {\n    level2: Level2\n}\n\nconst deep_obj = {\n    level2: {\n        level3: {\n            value: 999\n        }\n    }\n}\n\nprint deep_obj.level2.level3.value\n\n// Print of various literals\nprint 42\nprint 3.14159\nprint \"text\"\nprint true\nprint false\nprint null\n\n// Print model from list\nconst people = [\n    { name: \"Alice\", age: 30 },\n    { name: \"Bob\", age: 25 }\n]\nprint people[0]\nprint people[1].name\n"
  }
