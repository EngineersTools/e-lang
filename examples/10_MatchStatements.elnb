  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 10: Match Statements (Pattern Matching)\n// ============================================\n// Tests: match statements, multiple options,\n// default case, block vs expression returns\n\n// Simple match with numeric values\nconst day = 3\nmatch day {\n    1 => print \"Monday\"\n    2 => print \"Tuesday\"\n    3 => print \"Wednesday\"\n    4 => print \"Thursday\"\n    5 => print \"Friday\"\n    default => print \"Weekend\"\n}\n\n// Match with comparisons and blocks\nconst status = 200\nmatch status {\n    200 => {\n        print \"Success\"\n        print \"Request completed\"\n    }\n    404 => {\n        print \"Not found\"\n    }\n    500 => {\n        print \"Server error\"\n    }\n    default => {\n        print \"Unknown status\"\n    }\n}\n\n// Match with text values\nconst color = \"red\"\nmatch color {\n    \"red\" => print \"Color is red\"\n    \"green\" => print \"Color is green\"\n    \"blue\" => print \"Color is blue\"\n    default => print \"Unknown color\"\n}\n\n// Match with complex conditions\nconst temperature = 25\nmatch temperature {\n    10 => print \"Cold\"\n    20 => print \"Cool\"\n    25 => print \"Comfortable\"\n    30 => print \"Warm\"\n    default => print \"Extreme\"\n}\n\n// Match with boolean values\nconst isActive = true\nmatch isActive {\n    true => print \"System is active\"\n    false => print \"System is inactive\"\n}\n\n// Match returning values to variables\nconst category = 5\nconst result = match category {\n    1 => \"one\"\n    2 => \"two\"\n    3 => \"three\"\n    default => \"other\"\n}\nprint result\n\n// Match with blocks returning values\nconst priority = 2\nconst priority_level = match priority {\n    1 => { print \"High priority\" return \"HIGH\" }\n    2 => { print \"Medium priority\" return \"MEDIUM\" }\n    3 => { print \"Low priority\" return \"LOW\" }\n    default => { print \"No priority\" return \"NONE\" }\n}\nprint priority_level\n\n// Nested match statements\nconst input = 15\nmatch input {\n    10 => {\n        match input {\n            5 => print \"Inner: 5\"\n            10 => print \"Inner: 10\"\n        }\n    }\n    15 => {\n        print \"Matched 15\"\n        match input {\n            15 => print \"Inner: 15\"\n        }\n    }\n    default => print \"Other value\"\n}\n"
  }
]