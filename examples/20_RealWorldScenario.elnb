  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 20: Real-World Engineering Scenarios\n// ============================================\n// Practical examples combining multiple features\n// for realistic engineering use cases\n\ndomain structural_engineering\n\n// Units and dimensions for structural analysis\ndimension Length\ndimension Force\ndimension Pressure\ndimension Moment = Force * Length\n\nunit meter : Length\nunit millimeter : Length\nunit newton : Force\nunit kilonewton = 1000 * newton\nunit pascal : Pressure\nunit megapascal = 1000000 * pascal\nunit newton_meter : Moment\n\n// Export common constants\nexport const PI = 3.14159265\nexport const GRAVITY = 9.81\nexport const STEEL_DENSITY = 7850\n\n// Model for beam properties\nmodel Material {\n    name: text,\n    density: number,\n    youngs_modulus: number,\n    yield_strength: number\n}\n\n// Model for cross-section\nmodel CrossSection {\n    area: number,\n    inertia_moment: number,\n    centroid: number\n}\n\n// Model for beam\nmodel Beam {\n    id: number,\n    material: Material,\n    section: CrossSection,\n    length: number,\n    support_left: text,\n    support_right: text\n}\n\n// Formula for bending stress\nexport formula bending_stress(moment: number, inertia: number, distance: number) : number {\n    if (inertia == 0) {\n        return 0\n    }\n    return (moment * distance) / inertia\n}\n\n// Formula for deflection\nexport formula max_deflection(load: number, length: number, modulus: number, inertia: number) : number {\n    if (inertia == 0 or modulus == 0) {\n        return 0\n    }\n    const l_squared = length ^ 2\n    return (load * (l_squared ^ 2)) / (48 * modulus * inertia)\n}\n\n// Formula for shear force\nexport formula max_shear(total_load: number) : number {\n    return total_load / 2\n}\n\n// Formula for beam weight\nformula beam_weight(length: number, area: number, density: number) : number {\n    return length * area * density / 1000000\n}\n\n// Material database\nconst steel = {\n    name: \"Steel S355\",\n    density: 7850,\n    youngs_modulus: 210000,\n    yield_strength: 355\n}\n\nconst aluminum = {\n    name: \"Aluminum 6061\",\n    density: 2700,\n    youngs_modulus: 69000,\n    yield_strength: 276\n}\n\nconst concrete = {\n    name: \"Concrete C30\",\n    density: 2400,\n    youngs_modulus: 30000,\n    yield_strength: 30\n}\n\nprint \"=== Materials ===\"\nprint steel.name\nprint aluminum.name\nprint concrete.name\n\n// Cross-section definitions\nconst ipe_200_section = {\n    area: 2850,\n    inertia_moment: 1943000,\n    centroid: 100\n}\n\nconst ipe_300_section = {\n    area: 4260,\n    inertia_moment: 8356000,\n    centroid: 150\n}\n\n// Create beam instances\nconst beam1 = {\n    id: 1,\n    material: steel,\n    section: ipe_200_section,\n    length: 5000,\n    support_left: \"fixed\",\n    support_right: \"pin\"\n}\n\nconst beam2 = {\n    id: 2,\n    material: steel,\n    section: ipe_300_section,\n    length: 8000,\n    support_left: \"pin\",\n    support_right: \"pin\"\n}\n\nprint \"=== Beams ===\"\nprint beam1\nprint beam2\n\n// Analysis calculations\nprint \"\\n=== Structural Analysis ===\"\n\n// Beam 1 analysis\nconst load1 = 50000\nconst moment1 = load1 * (beam1.length / 4)\nconst stress1 = bending_stress(moment1, beam1.section.inertia_moment, beam1.section.centroid)\nconst deflection1 = max_deflection(load1, beam1.length, beam1.material.youngs_modulus, beam1.section.inertia_moment)\nconst shear1 = max_shear(load1)\nconst weight1 = beam_weight(beam1.length, beam1.section.area, beam1.material.density)\n\nprint \"Beam 1 - Load: 50 kN\"\nprint stress1\nprint deflection1\nprint shear1\nprint weight1\n\n// Beam 2 analysis\nconst load2 = 100000\nconst moment2 = load2 * (beam2.length / 4)\nconst stress2 = bending_stress(moment2, beam2.section.inertia_moment, beam2.section.centroid)\nconst deflection2 = max_deflection(load2, beam2.length, beam2.material.youngs_modulus, beam2.section.inertia_moment)\nconst shear2 = max_shear(load2)\nconst weight2 = beam_weight(beam2.length, beam2.section.area, beam2.material.density)\n\nprint \"Beam 2 - Load: 100 kN\"\nprint stress2\nprint deflection2\nprint shear2\nprint weight2\n\n// Safety factor calculation\nformula safety_factor(actual_stress: number, yield_stress: number) : number {\n    if (actual_stress == 0) {\n        return 999\n    }\n    return yield_stress / actual_stress\n}\n\nconst sf1 = safety_factor(stress1, beam1.material.yield_strength)\nconst sf2 = safety_factor(stress2, beam2.material.yield_strength)\n\nprint \"\\n=== Safety Factors ===\"\nprint sf1\nprint sf2\n\n// Check safety\nprint \"\\n=== Safety Check ===\"\nif (sf1 > 1.5) {\n    print \"Beam 1: SAFE\"\n} else {\n    print \"Beam 1: UNSAFE\"\n}\n\nif (sf2 > 1.5) {\n    print \"Beam 2: SAFE\"\n} else {\n    print \"Beam 2: UNSAFE\"\n}\n\n// Analysis loop for multiple load cases\nprint \"\\n=== Load Case Analysis ===\"\nfor (var load_case: number = 10000 from 10000 to 50000 step 10000) {\n    const M = load_case * (beam1.length / 4)\n    const stress = bending_stress(M, beam1.section.inertia_moment, beam1.section.centroid)\n    const sf = safety_factor(stress, beam1.material.yield_strength)\n    print load_case\n    print stress\n    print sf\n}\n\n// Measurements with units\nprint \"\\n=== With Unit Measurements ===\"\nconst beam_length = 5000 ~ millimeter\nconst applied_load = 50 ~ kilonewton\nconst stress_value = 250 ~ megapascal\n\nprint beam_length\nprint applied_load\nprint stress_value\n\nprint \"\\n=== Analysis Complete ===\"\n"
  }
]