dimension Length
unit m:Length
unit km = 1000 * m

model TestModel {
    numberProp: number
    textProp: text
    booleanProp: boolean
    lengthProp: Length
    lambdaProp: () => number
}

const testModel: TestModel = {
    numberProp: 1,
    textProp: "test",
    booleanProp: true,
    lengthProp: 1 ~m,
    lambdaProp: () => 34
}

print testModel

