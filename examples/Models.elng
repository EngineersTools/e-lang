// dimension Length2
// unit m2:Length2
// unit km2 = 1000 * m2

model TestModel {
    numberProp: number
    textProp: text
    booleanProp: boolean
    lengthProp: Length
    lambdaProp: (number) => number
}

const testModel: TestModel = {
    numberProp: 1,
    textProp: "test",
    booleanProp: true,
    lengthProp: 1 ~m,
    lambdaProp: (x: number) => x * 2
}

print testModel 

