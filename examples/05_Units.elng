// ============================================
// Test 05: Unit Declarations
// ============================================
// Tests: base unit declarations,
// derived unit expressions, unit operations

// Define base dimensions
dimension Length
dimension Mass
dimension Time

// Base units
unit meter : Length
unit kilogram : Mass
unit second : Time

// Exported units
export unit kilometer : Length
export unit gram : Mass

// Derived units - simple operations
unit hertz = 1 / second
unit newton = kilogram * meter / (second ^ 2)
unit joule = newton * meter
unit watt = joule / second

// Composite derived units
unit pascal = newton / (meter ^ 2)
unit tesla = kilogram / (second ^ 2)

// Complex unit expressions
unit volt = joule / (newton * meter)
unit ohm = volt / newton

// Units with numeric literals
unit decameter = 10 * meter
unit hectogram = 100 * gram

// More complex expressions
unit kilometer = 1000 * meter
unit milligram = gram / 1000

// Print unit references
print meter
print kilogram
print second
print hertz
print newton
print joule
print watt
print pascal
print volt
