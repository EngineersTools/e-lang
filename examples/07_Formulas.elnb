[
  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 07: Formula (Function) Declarations\n// ============================================\n// Tests: formula declarations, parameters,\n// return types, formula invocation\n\n// Simple formula with no parameters\nformula greet() : text {\n    return \"Hello from formula!\"\n}\n\n// Formula with single parameter\nformula double(x: number) : number {\n    return x * 2\n}\n\n// Formula with multiple parameters\nformula add(a: number, b: number) : number {\n    return a + b\n}\n\n// Formula with return type annotation\nformula multiply(x: number, y: number) : number {\n    const result = x * y\n    return result\n}\n\n// Formula without explicit return type\nformula subtract(a: number, b: number) {\n    return a - b\n}\n\n// Formula with type annotations on parameters\nformula power(base: number, exponent: number) : number {\n    return base ^ exponent\n}\n\n// Exported formula\nexport formula describe(name: text, age: number) : text {\n    const msg = name\n    return msg\n}\n\n// Formula with optional parameters\nformula optional_param(x: number, y?: number) : number {\n    const val = x + 5\n    return val\n}\n\n// Formula with conditional logic\nformula absolute(value: number) : number {\n    if (value >= 0) { return value }\n    else { return -value }\n}\n\n// Formula with local variables\nformula compute(a: number, b: number) : number {\n    var sum = a + b\n    var product = a * b\n    return sum + product\n}\n\n// Formula invocations\nprint greet()\nprint double(5)\nprint add(3, 7)\nprint multiply(4, 5)\nprint subtract(10, 3)\nprint power(2, 8)\nprint describe(\"Alice\", 25)\nprint absolute(-15)\nprint compute(2, 3)\n\n// Store formula results in variables\nconst greeting_result = greet()\nconst double_result = double(10)\nprint greeting_result\nprint double_result\n"
  }
]