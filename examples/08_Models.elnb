[
  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 08: Model Declarations and Expressions\n// ============================================\n// Tests: model declarations, model expressions,\n// member access, model inheritance\n\n// Simple model declaration\nmodel Person {\n    name: text,\n    age: number,\n    email: text\n}\n\n// Model with various types\nmodel Point {\n    x: number,\n    y: number,\n    z?: number\n}\n\n// Another model\nmodel Color {\n    r: number,\n    g: number,\n    b: number\n}\n\n// Model with optional parameters\nmodel Vehicle {\n    brand: text,\n    year: number,\n    owner?: text\n}\n\n// Exported model\nexport model Building {\n    address: text,\n    floors: number,\n    built_year: number\n}\n\n// Model with model inheritance\nmodel Employee extends Person {\n    employee_id: number,\n    department: text\n}\n\n// Create model instances using model expressions\nconst person1 = {\n    name: \"Alice\",\n    age: 30,\n    email: \"alice@example.com\"\n}\n\nconst person2 = {\n    name: \"Bob\",\n    age: 25,\n    email: \"bob@example.com\"\n}\n\nconst point1 = {\n    x: 10,\n    y: 20,\n    z: 30\n}\n\nconst point2 = {\n    x: 5,\n    y: 15\n}\n\nconst color = {\n    r: 255,\n    g: 128,\n    b: 64\n}\n\nconst vehicle = {\n    brand: \"Tesla\",\n    year: 2024,\n    owner: \"John\"\n}\n\nconst building = {\n    address: \"123 Main Street\",\n    floors: 10,\n    built_year: 2020\n}\n\nconst employee = {\n    name: \"Charlie\",\n    age: 35,\n    email: \"charlie@example.com\",\n    employee_id: 12345,\n    department: \"Engineering\"\n}\n\n// Print models\nprint person1\nprint person2\nprint point1\nprint color\nprint vehicle\nprint building\nprint employee\n\n// Member access with dot notation\nprint person1.name\nprint person1.age\nprint point1.x\nprint point1.y\nprint color.r\nprint employee.department\n"
  }
]