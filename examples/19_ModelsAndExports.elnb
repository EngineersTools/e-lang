  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 19: Models with Inheritance and Exports\n// ============================================\n// Tests: model inheritance, exported models,\n// exported formulas, exported variables\n\n// Base model\nmodel Animal {\n    name: text,\n    age: number\n}\n\n// Model extending another model\nmodel Dog extends Animal {\n    breed: text,\n    trained: boolean\n}\n\n// Multiple inheritance simulation (multiple extends)\nmodel Vehicle {\n    brand: text,\n    year: number\n}\n\nmodel Engine {\n    power: number,\n    fuel_type: text\n}\n\n// Model extending multiple models\nmodel Car extends Vehicle, Engine {\n    doors: number,\n    color: text\n}\n\n// Deep inheritance\nmodel Mammal extends Animal {\n    warm_blooded: boolean,\n    fur_color: text\n}\n\nmodel Dog2 extends Mammal {\n    breed: text,\n    trained: boolean\n}\n\n// Exported base model\nexport model Product {\n    id: number,\n    name: text,\n    price: number\n}\n\n// Exported model extending another model\nexport model DigitalProduct extends Product {\n    download_link: text,\n    file_size: number\n}\n\n// Create instances of inherited models\nconst dog = {\n    name: \"Buddy\",\n    age: 5,\n    breed: \"Golden Retriever\",\n    trained: true\n}\n\nprint dog\nprint dog.name\nprint dog.breed\nprint dog.trained\n\n// Create car instance\nconst car = {\n    brand: \"Tesla\",\n    year: 2024,\n    power: 500,\n    fuel_type: \"Electric\",\n    doors: 4,\n    color: \"Red\"\n}\n\nprint car\nprint car.brand\nprint car.power\nprint car.doors\n\n// Create mammal instance\nconst mammal_dog = {\n    name: \"Max\",\n    age: 3,\n    warm_blooded: true,\n    fur_color: \"Brown\",\n    breed: \"Labrador\",\n    trained: false\n}\n\nprint mammal_dog\n\n// Create product instance\nconst product = {\n    id: 101,\n    name: \"Laptop\",\n    price: 999.99\n}\n\nprint product\n\n// Create digital product\nconst digital_prod = {\n    id: 201,\n    name: \"eBook\",\n    price: 9.99,\n    download_link: \"https://example.com/ebook\",\n    file_size: 2.5\n}\n\nprint digital_prod\nprint digital_prod.price\nprint digital_prod.download_link\n\n// Exported formula with inherited model\nexport formula describe_product(p: Product) : text {\n    return p.name\n}\n\nprint describe_product(product)\n\n// Exported formula with digital product\nexport formula describe_digital(dp: DigitalProduct) : text {\n    return dp.name\n}\n\nprint describe_digital(digital_prod)\n\n// Exported constants\nexport const MAX_DOGS = 10\nexport const SYSTEM_VERSION = \"2.0\"\nexport const API_URL = \"https://api.example.com\"\n\nprint MAX_DOGS\nprint SYSTEM_VERSION\nprint API_URL\n\n// Exported variables\nexport var active_sessions = 0\nexport var total_users = 100\n\nprint active_sessions\nprint total_users\n\n// Modify exported variables\nactive_sessions = 5\ntotal_users = 150\nprint active_sessions\nprint total_users\n\n// Export formula that works with inherited models\nexport formula get_animal_age(a: Animal) : number {\n    return a.age\n}\n\nprint get_animal_age(dog)\n\n// Formula working with multiple inheritance chain\nformula display_mammal(m: Mammal) : text {\n    return m.name\n}\n\nprint display_mammal(mammal_dog)\n\n// Complex model with exported status\nexport model Settings {\n    debug: boolean,\n    timeout: number\n}\n\nexport model Configuration {\n    app_name: text,\n    version: text,\n    settings: Settings\n}\n\nconst config = {\n    app_name: \"MyApp\",\n    version: \"1.0.0\",\n    settings: {\n        debug: true,\n        timeout: 30\n    }\n}\n\nprint config\nprint config.settings\n"
  }
]