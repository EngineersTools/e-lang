[
  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 09: Control Flow - If, Else If, Else\n// ============================================\n// Tests: if statements, else_if chains,\n// else blocks, nested conditions\n\n// Simple if statement\nconst x = 10\nif (x > 5) {\n    print \"x is greater than 5\"\n}\n\n// If with else block\nconst y = 3\nif (y > 5) {\n    print \"y is greater than 5\"\n} else {\n    print \"y is not greater than 5\"\n}\n\n// If with else_if chain\nconst score = 75\nif (score >= 90) {\n    print \"Grade: A\"\n} else_if (score >= 80) {\n    print \"Grade: B\"\n} else_if (score >= 70) {\n    print \"Grade: C\"\n} else_if (score >= 60) {\n    print \"Grade: D\"\n} else {\n    print \"Grade: F\"\n}\n\n// Nested if statements\nconst age = 25\nconst hasLicense = true\nif (age >= 18) {\n    if (hasLicense) {\n        print \"Can drive\"\n    } else {\n        print \"Cannot drive - no license\"\n    }\n} else {\n    print \"Too young to drive\"\n}\n\n// Multiple conditions with logical operators\nconst temp = 20\nif (temp > 15 and temp < 25) {\n    print \"Temperature is comfortable\"\n}\n\nif (temp < 0 or temp > 30) {\n    print \"Temperature is extreme\"\n}\n\n// If with complex expressions\nconst value = 42\nif (value == 42 and value > 40 or value < 50) {\n    print \"Condition met\"\n}\n\n// If with variable conditions\nvar condition = true\nif (condition) {\n    print \"Condition is true\"\n}\n\ncondition = false\nif (condition) {\n    print \"This won't print\"\n} else {\n    print \"Condition is false\"\n}\n"
  }
]