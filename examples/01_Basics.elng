// ============================================
// Test 01: Basic Language Features
// ============================================
// Tests: domain declaration, const/var variables, 
// type annotations, print statements

domain engineering

// Constant declarations
const PI = 3.14159
const MAX_VALUE: number = 100
export const VERSION = "1.0"

// Mutable variable declarations
var counter: number = 0
var message: text = "Hello, e-lang!"
var isActive: boolean = true

// Variables without initial assignment
var uninitialized: number
const typeAnnotatedConst: text

// Print output to visualize execution
print PI
print MAX_VALUE
print message
print isActive
print counter

// Modify mutable variable
counter = 42
print counter

// Assignment expression test
var x = 10
x = 20
print x

// String literals - single and double quotes
const greeting = 'Welcome to e-lang'
const description = "A language for engineers"
print greeting
print description
