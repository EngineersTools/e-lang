dimension Length
unit m:Length
unit km = 1000 * m

dimension Time
unit s:Time
unit hr = 3600 * s

dimension Speed
unit mps = m / s
unit kph:Speed = km / hr

const x = 100 ~m
const y = 1 ~km
const z = 1 ~hr
const vel: Speed = 10 ~mps
const vel2 = 36 ~kph

print x + y
print vel + vel2
print vel + 5 ~mps
print 20 ~mps - 5 ~kph


