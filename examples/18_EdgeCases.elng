// ============================================
// Test 18: Edge Cases and Complex Combinations
// ============================================
// Tests: complex nested expressions,
// edge cases, unusual but valid combinations

// Empty model
const empty_model = {}
print empty_model

// Deeply nested expressions
const deep_calc = ((((5 + 3) * 2) - 4) / 2) ^ 2
print deep_calc

// Comparison chains
const chain = (5 < 10) and (10 < 20) and (20 < 100)
print chain

// Or chains
const or_chain = (1 > 10) or (5 > 2) or (3 > 8)
print or_chain

// Complex boolean expressions
const bool_expr = (true and false) or (true and true) or (false or true)
print bool_expr

// Negative numbers in expressions
const neg1 = -5 + 3
const neg2 = -10 * -2
const neg3 = -(5 + 3)
print neg1
print neg2
print neg3

// Double negative
const double_neg = - -5
print double_neg

// Not chains (should work)
const not_chain = not not true
print not_chain

// Complex list expressions
const empty_lists = [[], [], []]
print empty_lists

const list_of_lists_of_lists = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
print list_of_lists_of_lists

// Model with null members
const model_with_nulls = {
    field1: null,
    field2: null,
    field3: 42
}
print model_with_nulls

// Lambda with no body parameters
const no_params = () => 42
print no_params()

// Lambda with just a block
const lambda_block = (x: number) => {
    var result = x * 2
    return result
}
print lambda_block(5)

// Multiple lambdas in list
const lambda_list = [
    (x: number) => x + 1,
    (x: number) => x * 2,
    (x: number) => x ^ 2
]
print lambda_list[0](5)

// For loop with formula in step
formula get_step() : number {
    return 2
}

for (var i: number = 0 from 0 to 10 step get_step()) {
    print i
}

// Match with complex return values
const match_result = match 5 {
    1 => 10
    2 => 20
    5 => {
        var calc = 5 * 5
        return calc
    }
    default => 0
}
print match_result

// If statement as expression in assignment
var assigned_if = (() => {
    if (true) {
        return 42
    } else {
        return 0
    }
})()

// Ternary-like pattern with match
const ternary_pattern = match true {
    true => "yes"
    false => "no"
}
print ternary_pattern

// Empty for loop
print "Empty for loop:"
for (var i: number = 5 from 5 to 5) {
    print i
}

// For loop with same start and end
for (var i: number = 10 from 10 to 10) {
    print "Single iteration"
    print i
}

// Assignment in if condition
const assignment_cond = 10
if (assignment_cond == 10) {
    print "Assignment works in conditions"
}

// Complex model with lambdas
model Config {
    name: text,
    value: number,
    processor: (number) => number
}

const config_with_lambda = {
    name: "test",
    value: 42,
    processor: (x: number) => x * 2
}
print config_with_lambda

// Post-unary on formula result
formula get_value() : number {
    return 5
}

var post_result = get_value() + 1
print post_result

// Post-unary chains (if supported)
var counter = 10
var a = counter++
var b = counter--
print a
print b
print counter

// Multiple assignments
var x = 5
x = 10
x = 15
x = 20
print x

// Assignment with expression
var y = 0
y = 5 + 3
y = y * 2
y = y - 4
print y

// Formula with all optional parameters
formula all_optional(a?: number, b?: number, c?: number) : number {
    return 10
}
print all_optional()
print all_optional(1)
print all_optional(1, 2)
print all_optional(1, 2, 3)

// List with operations
const list_ops = [1 + 1, 2 * 3, 4 ^ 2, 10 / 2]
print list_ops

// Index with complex expression
const idx_calc = [10, 20, 30, 40, 50]
const index = 1 + 1
print idx_calc[index]

// Member access chain
model Level3 {
    value: number
}

model Level2 {
    level3: Level3
}

model Level1 {
    level2: Level2
}

const deep_obj = {
    level2: {
        level3: {
            value: 999
        }
    }
}

print deep_obj.level2.level3.value

// Print of various literals
print 42
print 3.14159
print "text"
print true
print false
print null

// Print model from list
const people = [
    { name: "Alice", age: 30 },
    { name: "Bob", age: 25 }
]
print people[0]
print people[1].name
