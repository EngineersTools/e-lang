[
  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 11: For Loops\n// ============================================\n// Tests: for loop syntax, loop variables,\n// from/to ranges, step expressions\n\n// Simple for loop (default step of 1)\nprint \"Loop 1: Basic count from 1 to 5\"\nfor (var i: number = 1 from 1 to 5) {\n    print i\n}\n\n// For loop with explicit count variable\nprint \"Loop 2: Count from 10 to 15\"\nfor (const counter: number = 10 from 10 to 15) {\n    print counter\n}\n\n// For loop with step size\nprint \"Loop 3: Count by 2s from 0 to 10\"\nfor (var x: number = 0 from 0 to 10 step 2) {\n    print x\n}\n\n// For loop with larger step\nprint \"Loop 4: Count by 5s from 0 to 50\"\nfor (var num: number = 0 from 0 to 50 step 5) {\n    print num\n}\n\n// For loop with step 1 explicitly\nprint \"Loop 5: Count from 20 to 23 with step 1\"\nfor (const n: number = 20 from 20 to 23 step 1) {\n    print n\n}\n\n// For loop with negative range (if supported)\nprint \"Loop 6: Counting calculations\"\nfor (var idx: number = 1 from 1 to 5) {\n    const squared = idx * idx\n    print squared\n}\n\n// For loop with complex block\nprint \"Loop 7: Loop with multiple statements\"\nfor (var i: number = 1 from 1 to 3) {\n    const double_i = i * 2\n    const triple_i = i * 3\n    print double_i\n    print triple_i\n}\n\n// For loop building results\nprint \"Loop 8: Loop with variable accumulation\"\nvar sum = 0\nfor (const i: number = 1 from 1 to 5) {\n    sum = sum + i\n}\nprint sum\n\n// For loop with formula call\nformula square(x: number) : number {\n    return x * x\n}\n\nprint \"Loop 9: Loop calling formulas\"\nfor (var k: number = 1 from 1 to 5) {\n    const squared = square(k)\n    print squared\n}\n\n// Nested for loops\nprint \"Loop 10: Nested loops\"\nfor (var i: number = 1 from 1 to 3) {\n    for (var j: number = 1 from 1 to 3) {\n        print i\n        print j\n    }\n}\n\n// For loop with fractional step\nprint \"Loop 11: Loop with decimal step\"\nfor (var val: number = 0 from 0 to 2 step 0.5) {\n    print val\n}\n"
  }
]