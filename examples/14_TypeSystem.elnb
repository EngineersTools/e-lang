  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 14: Type System and Annotations\n// ============================================\n// Tests: type references, unions, intersections,\n// type annotations, parameterized types\n\n// Basic type annotations\nconst num: number = 42\nconst txt: text = \"hello\"\nconst flag: boolean = true\n\n// Null type\nconst empty: null = null\n\n// List types\nconst numbers: number list = [1, 2, 3]\nconst strings: text list = [\"a\", \"b\", \"c\"]\nconst booleans: boolean list = [true, false]\n\n// Type union - value can be number OR text\nformula flexible(value: number or text) : text {\n    return value\n}\n\nprint flexible(42)\nprint flexible(\"hello\")\n\n// More complex union types\nformula process(data: number or text or boolean) {\n    return data\n}\n\nprint process(10)\nprint process(\"test\")\nprint process(true)\n\n// Model types\nmodel Person {\n    name: text,\n    age: number\n}\n\nconst person: Person = {\n    name: \"Alice\",\n    age: 30\n}\n\nprint person\n\n// List of specific model types\nconst people: Person list = [\n    { name: \"Alice\", age: 30 },\n    { name: \"Bob\", age: 25 }\n]\n\nprint people\n\n// Lambda types in parameters\nformula apply_operation(fn: (number) => number, value: number) : number {\n    return fn(value)\n}\n\nconst increment = (x: number) => x + 1\nprint apply_operation(increment, 5)\n\n// Lambda returning lambda type\nformula create_adder(amount: number) : (number) => number {\n    return (x: number) => x + amount\n}\n\nconst add_ten = create_adder(10)\nprint add_ten(5)\n\n// Type intersection - value must satisfy multiple types\n// (if supported by the type system)\nformula validate(value: number) : boolean {\n    return value > 0\n}\n\n// Generic-style handling with unions\nformula handle_any(data: number or text or boolean) : text {\n    return \"received data\"\n}\n\nprint handle_any(42)\nprint handle_any(\"test\")\nprint handle_any(true)\n\n// Optional parameters with type annotations\nformula optional_param(required: number, optional?: text) : text {\n    return \"processed\"\n}\n\nprint optional_param(10)\nprint optional_param(10, \"data\")\n\n// Complex nested types\nformula nested_lists(matrix: number list list) {\n    return matrix\n}\n\nconst grid = [[1, 2], [3, 4]]\nprint nested_lists(grid)\n\n// Function type as return type\nformula get_calculator() : (number, number) => number {\n    return (a: number, b: number) => a + b\n}\n\nconst calculator = get_calculator()\nprint calculator(5, 3)\n"
  }
]