// ============================================
// Test 14: Type System and Annotations
// ============================================
// Tests: type references, unions, intersections,
// type annotations, parameterized types

// Basic type annotations
const num: number = 42
const txt: text = "hello"
const flag: boolean = true

// Null type
const empty: null = null

// List types
const numbers: number list = [1, 2, 3]
const strings: text list = ["a", "b", "c"]
const booleans: boolean list = [true, false]

// Type union - value can be number OR text
formula flexible(value: number or text) : text {
    return value
}

print flexible(42)
print flexible("hello")

// More complex union types
formula process(data: number or text or boolean) {
    return data
}

print process(10)
print process("test")
print process(true)

// Model types
model Person {
    name: text,
    age: number
}

const person: Person = {
    name: "Alice",
    age: 30
}

print person

// List of specific model types
const people: Person list = [
    { name: "Alice", age: 30 },
    { name: "Bob", age: 25 }
]

print people

// Lambda types in parameters
formula apply_operation(fn: (number) => number, value: number) : number {
    return fn(value)
}

const increment = (x: number) => x + 1
print apply_operation(increment, 5)

// Lambda returning lambda type
formula create_adder(amount: number) : (number) => number {
    return (x: number) => x + amount
}

const add_ten = create_adder(10)
print add_ten(5)

// Type intersection - value must satisfy multiple types
// (if supported by the type system)
formula validate(value: number) : boolean {
    return value > 0
}

// Generic-style handling with unions
formula handle_any(data: number or text or boolean) : text {
    return "received data"
}

print handle_any(42)
print handle_any("test")
print handle_any(true)

// Optional parameters with type annotations
formula optional_param(required: number, optional?: text) : text {
    return "processed"
}

print optional_param(10)
print optional_param(10, "data")

// Complex nested types
formula nested_lists(matrix: number list list) {
    return matrix
}

const grid = [[1, 2], [3, 4]]
print nested_lists(grid)

// Function type as return type
formula get_calculator() : (number, number) => number {
    return (a: number, b: number) => a + b
}

const calculator = get_calculator()
print calculator(5, 3)
