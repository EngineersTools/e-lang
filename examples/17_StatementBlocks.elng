// ============================================
// Test 17: Statement Blocks and Return Values
// ============================================
// Tests: statement blocks with returns,
// nested blocks, block return values

// Simple statement block
const block_result = (() => {
    var x = 10
    var y = 20
    return x + y
})()
print block_result

// Nested statement blocks
const nested_result = (() => {
    var outer = 100
    return (() => {
        var inner = 50
        return outer + inner
    })()
})()
print nested_result

// Block with multiple statements
const complex_block = (() => {
    var a = 5
    var b = 3
    var c = a * b
    var d = c + 10
    print a
    print b
    print c
    return d
})()
print complex_block

// Block with conditional
const block_with_if = (() => {
    var value = 42
    if (value > 40) {
        return "high"
    } else {
        return "low"
    }
})()
print block_with_if

// Block with match
const block_with_match = (() => {
    var num = 2
    return match num {
        1 => "one"
        2 => {
            var doubled = num * 2
            return doubled
        }
        default => 0
    }
})()
print block_with_match

// Block with loop
const block_with_loop = (() => {
    var sum = 0
    for (var i: number = 1 from 1 to 5) {
        sum = sum + i
    }
    return sum
})()
print block_with_loop

// Formula returning a block value
formula get_block_value() {
    return (() => {
        var result = 100
        print "Computing..."
        return result
    })()
}

print get_block_value()

// Block as formula body
formula block_formula(x: number) : number {
    var temp = x * 2
    var final = temp + 5
    return final
}

print block_formula(10)

// Block with variable declarations
const test_block = (() => {
    const immutable = 50
    var mutable = 100
    return immutable + mutable
})()
print test_block
