    "content": "// ============================================\n// Test 17: Statement Blocks and Return Values\n// ============================================\n// Tests: statement blocks with returns,\n// nested blocks, block return values\n\n// Simple statement block\nconst block_result = (() => {\n    var x = 10\n    var y = 20\n    return x + y\n})()\nprint block_result\n\n// Nested statement blocks\nconst nested_result = (() => {\n    var outer = 100\n    return (() => {\n        var inner = 50\n        return outer + inner\n    })()\n})()\nprint nested_result\n\n// Block with multiple statements\nconst complex_block = (() => {\n    var a = 5\n    var b = 3\n    var c = a * b\n    var d = c + 10\n    print a\n    print b\n    print c\n    return d\n})()\nprint complex_block\n\n// Block with conditional\nconst block_with_if = (() => {\n    var value = 42\n    if (value > 40) {\n        return \"high\"\n    } else {\n        return \"low\"\n    }\n})()\nprint block_with_if\n\n// Block with match\nconst block_with_match = (() => {\n    var num = 2\n    return match num {\n        1 => \"one\"\n        2 => {\n            var doubled = num * 2\n            return doubled\n        }\n        default => 0\n    }\n})()\nprint block_with_match\n\n// Block with loop\nconst block_with_loop = (() => {\n    var sum = 0\n    for (var i: number = 1 from 1 to 5) {\n        sum = sum + i\n    }\n    return sum\n})()\nprint block_with_loop\n\n// Formula returning a block value\nformula get_block_value() {\n    return (() => {\n        var result = 100\n        print \"Computing...\"\n        return result\n    })()\n}\n\nprint get_block_value()\n\n// Block as formula body\nformula block_formula(x: number) : number {\n    var temp = x * 2\n    var final = temp + 5\n    return final\n}\n\nprint block_formula(10)\n\n// Block with variable declarations\nconst test_block = (() => {\n    const immutable = 50\n    var mutable = 100\n    return immutable + mutable\n})()\nprint test_block\n"
  }
