  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 15: Advanced Features and Edge Cases\n// ============================================\n// Tests: complex expressions, null handling,\n// nested structures, export statements\n\n// Export variables\nexport const PUBLIC_CONSTANT = 100\nexport var PUBLIC_VARIABLE = 50\n\n// Dimension and unit system test\ndimension Length\ndimension Mass\ndimension Time\n\nunit meter : Length\nunit second : Time\nunit kilogram : Mass\n\n// Complex measurements\nconst speed = (100 ~ meter) / (10 ~ second)\nprint speed\n\n// Test null handling\nconst nullable_value: null = null\nprint nullable_value\n\n// Null in expressions\nconst value_or_null = null\nif (value_or_null == null) {\n    print \"Value is null\"\n}\n\n// Complex nested model\nmodel Address {\n    street: text,\n    city: text,\n    zip: number\n}\n\nmodel Employee {\n    name: text,\n    id: number,\n    address: Address\n}\n\nconst employee = {\n    name: \"John\",\n    id: 123,\n    address: {\n        street: \"123 Main St\",\n        city: \"Anytown\",\n        zip: 12345\n    }\n}\n\nprint employee\nprint employee.address\nprint employee.address.city\n\n// Deeply nested list access\nconst deep_matrix = [\n    [\n        [1, 2],\n        [3, 4]\n    ],\n    [\n        [5, 6],\n        [7, 8]\n    ]\n]\n\nconst deep_value = deep_matrix[0][1][0]\nprint deep_value\n\n// Complex arithmetic with precedence\nconst calc = 2 + 3 * 4 ^ 2 - 5 / 2\nprint calc\n\n// Formula with all features\nformula comprehensive(\n    value: number,\n    text_val: text,\n    items: number list\n) : number {\n    var result = value * 2\n    \n    if (value > 0) {\n        result = result + 100\n    } else {\n        result = result - 100\n    }\n    \n    for (var i: number = 0 from 0 to 2) {\n        result = result + items[i]\n    }\n    \n    return result\n}\n\nconst comprehensive_result = comprehensive(10, \"test\", [1, 2, 3])\nprint comprehensive_result\n\n// Match with complex expressions\nconst value = 42\nconst category = match value {\n    0 => \"zero\"\n    1 => \"one\"\n    default => {\n        if (value < 10) {\n            \"small\"\n        } else {\n            \"large\"\n        }\n    }\n}\nprint category\n\n// Higher-order function\nformula create_operator(op: text) : (number, number) => number {\n    match op {\n        \"add\" => { return (a: number, b: number) => a + b }\n        \"mult\" => { return (a: number, b: number) => a * b }\n        default => { return (a: number, b: number) => a }\n    }\n}\n\n// Lambda in formula\nformula map_operation(fn: (number) => number, items: number list) : number list {\n    return items\n}\n\nconst doubled = map_operation((x: number) => x * 2, [1, 2, 3])\nprint doubled\n\n// Export formula\nexport formula calculate_total(amounts: number list) : number {\n    var sum = 0\n    for (var i: number = 0 from 0 to 1 step 1) {\n        sum = sum + amounts[i]\n    }\n    return sum\n}\n\nprint calculate_total([10, 20])\n\n// Complex boolean logic\nconst a = true\nconst b = false\nconst c = true\n\nconst complex_bool = (a or b) and (c or not b)\nprint complex_bool\n\n// Chained member access and indexing\nconst data = {\n    items: [\n        { value: 10 },\n        { value: 20 }\n    ]\n}\n\nprint data.items\nprint data.items[0]\nprint data.items[0].value\n\n// Complex type scenario\nmodel Result {\n    success: boolean,\n    data: number or text,\n    items: number list\n}\n\nconst result_obj = {\n    success: true,\n    data: 42,\n    items: [1, 2, 3]\n}\n\nprint result_obj\n\n// Imaginary numbers in calculations\nconst real = 5\nconst imag = 3im\nconst complex_num = real + imag\nprint complex_num\n\n// Statements and blocks\n{\n    var scoped_value = 100\n    print scoped_value\n    {\n        var nested_value = 200\n        print nested_value\n    }\n}\n"
  }
]