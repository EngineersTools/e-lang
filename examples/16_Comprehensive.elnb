  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 16: Comprehensive Integration Test\n// ============================================\n// Complete program using all major features\n// in realistic engineering scenario\n\ndomain engineering_calculations\n\n// Import capability (placeholder)\n// import \"external_lib\"\n\n// ========== Dimensions and Units ==========\ndimension Length\ndimension Mass\ndimension Time\ndimension Temperature\ndimension Velocity = Length / Time\ndimension Acceleration = Length / (Time ^ 2)\ndimension Force = Mass * Length / (Time ^ 2)\ndimension Energy = Force * Length\n\nunit meter : Length\nunit kilometer : Length\nunit gram : Mass\nunit kilogram : Mass\nunit second : Time\nunit newton : Force\nunit joule : Energy\n\n// Derived units\nunit kilometer_per_hour = kilometer / second\nunit meter_per_second = meter / second\nunit acceleration_unit = meter / (second ^ 2)\n\nprint \"=== Units Defined ===\"\nprint meter\nprint kilogram\nprint newton\nprint joule\n\n// ========== Models for Physics ==========\nmodel Vector3D {\n    x: number,\n    y: number,\n    z: number\n}\n\nmodel ForceVector extends Vector3D {\n    magnitude: number\n}\n\nmodel PhysicsObject {\n    name: text,\n    mass: number,\n    velocity: Vector3D,\n    position: Vector3D\n}\n\nprint \"=== Models Defined ===\"\n\n// ========== Constants and Variables ==========\nexport const GRAVITY = 9.8\nexport const PI = 3.14159\nconst SPEED_OF_LIGHT = 299792458\n\nvar simulation_running = true\nvar time_elapsed = 0\n\nprint \"=== Constants ===\"\nprint GRAVITY\nprint PI\nprint SPEED_OF_LIGHT\n\n// ========== Physics Formulas ==========\n\nexport formula calculate_force(mass: number, acceleration: number) : number {\n    return mass * acceleration\n}\n\nexport formula calculate_kinetic_energy(mass: number, velocity: number) : number {\n    return 0.5 * mass * (velocity ^ 2)\n}\n\nexport formula calculate_distance(initial_velocity: number, acceleration: number, time: number) : number {\n    return initial_velocity * time + 0.5 * acceleration * (time ^ 2)\n}\n\nexport formula calculate_final_velocity(initial_velocity: number, acceleration: number, time: number) : number {\n    return initial_velocity + acceleration * time\n}\n\nformula vector_magnitude(v: Vector3D) : number {\n    const x_squared = v.x ^ 2\n    const y_squared = v.y ^ 2\n    const z_squared = v.z ^ 2\n    return x_squared + y_squared + z_squared\n}\n\nformula is_valid_mass(m: number) : boolean {\n    return m > 0 and m < 10000\n}\n\nformula is_valid_velocity(v: number) : boolean {\n    return v >= 0 and v < SPEED_OF_LIGHT\n}\n\nprint \"=== Formulas Defined ===\"\n\n// ========== Calculations and Tests ==========\n\nprint \"\\n=== Force Calculations ===\"\nconst mass_kg = 50\nconst acceleration_ms2 = 2\nconst force_n = calculate_force(mass_kg, acceleration_ms2)\nprint force_n\n\nprint \"\\n=== Kinetic Energy Calculations ===\"\nconst obj_mass = 100\nconst obj_velocity = 10\nconst kinetic_energy = calculate_kinetic_energy(obj_mass, obj_velocity)\nprint kinetic_energy\n\nprint \"\\n=== Distance Calculations ===\"\nconst initial_vel = 5\nconst accel = 2\nconst time_s = 10\nconst distance = calculate_distance(initial_vel, accel, time_s)\nprint distance\n\nprint \"\\n=== Velocity Calculations ===\"\nconst final_vel = calculate_final_velocity(initial_vel, accel, time_s)\nprint final_vel\n\n// ========== Measurements ==========\n\nprint \"\\n=== Measurements with Units ===\"\nconst distance_m = 100 ~ meter\nconst distance_km = 10 ~ kilometer\nprint distance_m\nprint distance_km\n\nconst speed_ms = (100 ~ meter) / (10 ~ second)\nprint speed_ms\n\n// ========== Control Flow with Real Data ==========\n\nprint \"\\n=== Control Flow Tests ===\"\nconst object_mass = 75\nif (is_valid_mass(object_mass)) {\n    print \"Mass is valid\"\n} else {\n    print \"Mass is invalid\"\n}\n\nconst object_velocity = 50\nif (is_valid_velocity(object_velocity)) {\n    if (object_velocity > 20) {\n        print \"High speed\"\n    } else {\n        print \"Low speed\"\n    }\n}\n\n// ========== Match Statements ==========\n\nprint \"\\n=== Match Statement Tests ===\"\nconst simulation_state = 1\nmatch simulation_state {\n    0 => print \"State: Idle\"\n    1 => print \"State: Running\"\n    2 => print \"State: Paused\"\n    default => print \"State: Unknown\"\n}\n\nconst object_type = \"rigid_body\"\nmatch object_type {\n    \"rigid_body\" => print \"Object Type: Rigid Body\"\n    \"soft_body\" => print \"Object Type: Soft Body\"\n    \"fluid\" => print \"Object Type: Fluid\"\n    default => print \"Object Type: Unknown\"\n}\n\n// ========== Loops and Iterations ==========\n\nprint \"\\n=== Loop Tests ===\"\nprint \"Time steps:\"\nfor (var t: number = 0 from 0 to 10 step 2) {\n    const distance_at_t = calculate_distance(initial_vel, accel, t)\n    print distance_at_t\n}\n\n// ========== Collections ==========\n\nprint \"\\n=== Collection Tests ===\"\nconst positions = [\n    { x: 0, y: 0, z: 0 },\n    { x: 10, y: 20, z: 30 },\n    { x: 50, y: 60, z: 70 }\n]\n\nprint positions\nprint positions[0]\nprint positions[1].x\nprint positions[2].y\n\nconst masses = [10, 20, 30, 40, 50]\nprint masses\nprint masses[2]\n\nconst velocities = [1.5, 2.5, 3.5]\nprint velocities\n\n// ========== Lambda Functions ==========\n\nprint \"\\n=== Lambda Tests ===\"\nconst square = (x: number) => x ^ 2\nprint square(5)\n\nconst add_numbers = (a: number, b: number) => a + b\nprint add_numbers(10, 20)\n\nconst create_multiplier = (factor: number) => {\n    return (x: number) => x * factor\n}\n\nconst times_ten = create_multiplier(10)\nconst times_hundred = create_multiplier(100)\n\nprint times_ten(5)\nprint times_hundred(3)\n\n// ========== Complex Data Structures ==========\n\nprint \"\\n=== Complex Objects ===\"\nconst physics_obj = {\n    name: \"Test Ball\",\n    mass: 10,\n    velocity: { x: 5, y: 10, z: 0 },\n    position: { x: 0, y: 0, z: 0 }\n}\n\nprint physics_obj\nprint physics_obj.name\nprint physics_obj.mass\nprint physics_obj.velocity\nprint physics_obj.velocity.x\nprint physics_obj.position\n\n// ========== Logical Operations ==========\n\nprint \"\\n=== Logical Operations ===\"\nconst condition1 = true and false\nprint condition1\n\nconst condition2 = true or false\nprint condition2\n\nconst condition3 = not false\nprint condition3\n\nconst combined = (mass_kg > 0) and (object_velocity < 100) and (time_s > 0)\nprint combined\n\n// ========== Type Annotations ==========\n\nformula typed_formula(\n    masses: number list,\n    velocities: number list\n) : number {\n    return 0\n}\n\nconst result = typed_formula([10, 20], [5, 10])\nprint result\n\n// ========== Null Handling ==========\n\nprint \"\\n=== Null Handling ===\"\nconst maybe_null = null\nif (maybe_null == null) {\n    print \"Value is null\"\n}\n\n// ========== Export Test ==========\n\nexport formula public_calculation(x: number) : number {\n    return x * 2 + 10\n}\n\nprint \"\\n=== Final Results ===\"\nprint public_calculation(25)\n\n// ========== Final Summary ==========\n\nprint \"\\n=== Test Complete ===\"\nprint \"All language features tested successfully!\"\n"
  }
]