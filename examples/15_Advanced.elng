// ============================================
// Test 15: Advanced Features and Edge Cases
// ============================================
// Tests: complex expressions, null handling,
// nested structures, export statements

// Export variables
export const PUBLIC_CONSTANT = 100
export var PUBLIC_VARIABLE = 50

// Dimension and unit system test
dimension Length
dimension Mass
dimension Time

unit meter : Length
unit second : Time
unit kilogram : Mass

// Complex measurements
const speed = (100 ~ meter) / (10 ~ second)
print speed

// Test null handling
const nullable_value: null = null
print nullable_value

// Null in expressions
const value_or_null = null
if (value_or_null == null) {
    print "Value is null"
}

// Complex nested model
model Address {
    street: text,
    city: text,
    zip: number
}

model Employee {
    name: text,
    id: number,
    address: Address
}

const employee = {
    name: "John",
    id: 123,
    address: {
        street: "123 Main St",
        city: "Anytown",
        zip: 12345
    }
}

print employee
print employee.address
print employee.address.city

// Deeply nested list access
const deep_matrix = [
    [
        [1, 2],
        [3, 4]
    ],
    [
        [5, 6],
        [7, 8]
    ]
]

const deep_value = deep_matrix[0][1][0]
print deep_value

// Complex arithmetic with precedence
const calc = 2 + 3 * 4 ^ 2 - 5 / 2
print calc

// Formula with all features
formula comprehensive(
    value: number,
    text_val: text,
    items: number list
) : number {
    var result = value * 2
    
    if (value > 0) {
        result = result + 100
    } else {
        result = result - 100
    }
    
    for (var i: number = 0 from 0 to 2) {
        result = result + items[i]
    }
    
    return result
}

const comprehensive_result = comprehensive(10, "test", [1, 2, 3])
print comprehensive_result

// Match with complex expressions
const value = 42
const category = match value {
    0 => "zero"
    1 => "one"
    default => {
        if (value < 10) {
            "small"
        } else {
            "large"
        }
    }
}
print category

// Higher-order function
formula create_operator(op: text) : (number, number) => number {
    match op {
        "add" => return (a: number, b: number) => a + b
        "mult" => return (a: number, b: number) => a * b
        default => return (a: number, b: number) => a
    }
}

// Lambda in formula
formula map_operation(fn: (number) => number, items: number list) : number list {
    return items
}

const doubled = map_operation((x: number) => x * 2, [1, 2, 3])
print doubled

// Export formula
export formula calculate_total(amounts: number list) : number {
    var sum = 0
    for (var i: number = 0 from 0 to 1 step 1) {
        sum = sum + amounts[i]
    }
    return sum
}

print calculate_total([10, 20])

// Complex boolean logic
const a = true
const b = false
const c = true

const complex_bool = (a or b) and (c or not b)
print complex_bool

// Chained member access and indexing
const data = {
    items: [
        { value: 10 },
        { value: 20 }
    ]
}

print data.items
print data.items[0]
print data.items[0].value

// Complex type scenario
model Result {
    success: boolean,
    data: number or text,
    items: number list
}

const result_obj = {
    success: true,
    data: 42,
    items: [1, 2, 3]
}

print result_obj

// Imaginary numbers in calculations
const real = 5
const imag = 3im
const complex_num = real + imag
print complex_num

// Statements and blocks
{
    var scoped_value = 100
    print scoped_value
    {
        var nested_value = 200
        print nested_value
    }
}
