// ============================================
// Test 13: Lambda Expressions
// ============================================
// Tests: lambda syntax, parameters,
// return types, lambda invocation

// Simple lambda - no parameters
const say_hello = () => "Hello"
print say_hello()

// Lambda with single parameter
const double = (x: number) => x * 2
print double(5)

// Lambda with multiple parameters
const add = (a: number, b: number) => a + b
print add(3, 7)

// Lambda with return type annotation
const multiply = (x: number, y: number) : number => x * y
print multiply(4, 5)

// Lambda returning a string
const greet = (name: text) : text => name
print greet("Alice")

// Lambda with block body
const complex_calc = (x: number, y: number) : number => {
    const sum = x + y
    const product = x * y
    return sum + product
}
print complex_calc(2, 3)

// Lambda with optional parameters
const optional_add = (a: number, b?: number) : number => a + 10
print optional_add(5)

// Lambda with multiple statements in block
const process = (value: number) : number => {
    var result = value * 2
    result = result + 10
    return result
}
print process(5)

// Store lambda in variable and invoke
const square = (n: number) => n * n
const result = square(7)
print result

// Lambda as function parameter
formula apply(fn: (number) => number, value: number) : number {
    return fn(value)
}

const triple = (x: number) => x * 3
print apply(triple, 5)

// Lambda returning a lambda (higher-order)
const make_multiplier = (factor: number) => {
    return (x: number) => x * factor
}

const times_two = make_multiplier(2)
const times_three = make_multiplier(3)

print times_two(10)
print times_three(10)

// Lambda with complex parameter types
const process_text = (myText: text) : text => myText
print process_text("test")

// Lambda with union type
const convert = (value: number or text) => value
print convert(42)

// Lambda without explicit return type
const implicit_return = (x: number) => x + 100
print implicit_return(50)

// Lambda in list
const operations = [
    (x: number) => x + 1,
    (x: number) => x * 2,
    (x: number) => x ^ 2
]

print operations[0](5)
print operations[1](5)
print operations[2](5)
