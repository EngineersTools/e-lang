  {
    "kind": 2,
    "languageId": "e-lang",
    "content": "// ============================================\n// Test 13: Lambda Expressions\n// ============================================\n// Tests: lambda syntax, parameters,\n// return types, lambda invocation\n\n// Simple lambda - no parameters\nconst say_hello = () => \"Hello\"\nprint say_hello()\n\n// Lambda with single parameter\nconst double = (x: number) => x * 2\nprint double(5)\n\n// Lambda with multiple parameters\nconst add = (a: number, b: number) => a + b\nprint add(3, 7)\n\n// Lambda with return type annotation\nconst multiply = (x: number, y: number) : number => x * y\nprint multiply(4, 5)\n\n// Lambda returning a string\nconst greet = (name: text) : text => name\nprint greet(\"Alice\")\n\n// Lambda with block body\nconst complex_calc = (x: number, y: number) : number => {\n    const sum = x + y\n    const product = x * y\n    return sum + product\n}\nprint complex_calc(2, 3)\n\n// Lambda with optional parameters\nconst optional_add = (a: number, b?: number) : number => a + 10\nprint optional_add(5)\n\n// Lambda with multiple statements in block\nconst process = (value: number) : number => {\n    var result = value * 2\n    result = result + 10\n    return result\n}\nprint process(5)\n\n// Store lambda in variable and invoke\nconst square = (n: number) => n * n\nconst result = square(7)\nprint result\n\n// Lambda as function parameter\nformula apply(fn: (number) => number, value: number) : number {\n    return fn(value)\n}\n\nconst triple = (x: number) => x * 3\nprint apply(triple, 5)\n\n// Lambda returning a lambda (higher-order)\nconst make_multiplier = (factor: number) => {\n    return (x: number) => x * factor\n}\n\nconst times_two = make_multiplier(2)\nconst times_three = make_multiplier(3)\n\nprint times_two(10)\nprint times_three(10)\n\n// Lambda with complex parameter types\nconst process_text = (text: text) : text => text\nprint process_text(\"test\")\n\n// Lambda with union type\nconst convert = (value: number or text) => value\nprint convert(42)\n\n// Lambda without explicit return type\nconst implicit_return = (x: number) => x + 100\nprint implicit_return(50)\n\n// Lambda in list\nconst operations = [\n    (x: number) => x + 1,\n    (x: number) => x * 2,\n    (x: number) => x ^ 2\n]\n\nprint operations[0](5)\nprint operations[1](5)\nprint operations[2](5)\n"
  }
]