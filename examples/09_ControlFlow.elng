// ============================================
// Test 09: Control Flow - If, Else If, Else
// ============================================
// Tests: if statements, else_if chains,
// else blocks, nested conditions

// Simple if statement
const x = 10
if (x > 5) {
    print "x is greater than 5"
}

// If with else block
const y = 3
if (y > 5) {
    print "y is greater than 5"
} else {
    print "y is not greater than 5"
}

// If with else_if chain
const score = 75
if (score >= 90) {
    print "Grade: A"
} else_if (score >= 80) {
    print "Grade: B"
} else_if (score >= 70) {
    print "Grade: C"
} else_if (score >= 60) {
    print "Grade: D"
} else {
    print "Grade: F"
}

// Nested if statements
const age = 25
const hasLicense = true
if (age >= 18) {
    if (hasLicense) {
        print "Can drive"
    } else {
        print "Cannot drive - no license"
    }
} else {
    print "Too young to drive"
}

// Multiple conditions with logical operators
const temp = 20
if (temp > 15 and temp < 25) {
    print "Temperature is comfortable"
}

if (temp < 0 or temp > 30) {
    print "Temperature is extreme"
}

// If with complex expressions
const value = 42
if (value == 42 and value > 40 or value < 50) {
    print "Condition met"
}

// If with variable conditions
var condition = true
if (condition) {
    print "Condition is true"
}

condition = false
if (condition) {
    print "This won't print"
} else {
    print "Condition is false"
}
