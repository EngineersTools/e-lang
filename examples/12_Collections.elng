// ============================================
// Test 12: Collections - Lists and Indexing
// ============================================
// Tests: list expressions, indexing,
// member access, list operations

// Empty list
const empty_list = []
print empty_list

// List with numbers
const numbers = [1, 2, 3, 4, 5]
print numbers

// List with strings
const words = ["apple", "banana", "cherry", "date"]
print words

// List with booleans
const flags = [true, false, true, true, false]
print flags

// List with mixed expressions
const values = [10 + 5, 20 - 3, 15 * 2, 100 / 4]
print values

// List with decimals
const decimals = [1.5, 2.7, 3.14159, 4.2, 5.99]
print decimals

// List with null values
const mixed = [1, null, 3, null, 5]
print mixed

// Index access with integer
const my_list = [10, 20, 30, 40, 50]
const first = my_list[0]
const second = my_list[1]
const third = my_list[2]

print first
print second
print third

// Index access with expressions
const idx = 2
const value_at_idx = my_list[idx]
print value_at_idx

// List of model objects
model Point {
    x: number,
    y: number
}

const points = [
    { x: 0, y: 0 },
    { x: 5, y: 10 },
    { x: 10, y: 20 }
]

print points

// Accessing nested model members
const first_point = points[0]
print first_point.x
print first_point.y

// List of lists (nested lists)
const matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

print matrix

// Accessing nested list elements
const matrix_element = matrix[1][2]
print matrix_element

// List in formulas
formula get_first(items: number list) : number {
    return items[0]
}

formula get_length(items: number list) : number {
    return 5
}

const nums = [100, 200, 300, 400, 500]
print get_first(nums)

// List modifications with variables
var dynamic_list = [1, 2, 3]
print dynamic_list

// Index with calculation
const calc_idx = 1 + 1
const element = my_list[calc_idx]
print element
