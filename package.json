{
    "name": "e-lang-workspace",
    "description": "Base workspace package",
    "version": "0.1.1",
    "type": "module",
    "private": true,
    "scripts": {
        "update-versions": "node scripts/update-versions.js",
        "clean": "npm run clean --workspaces",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "build:language": "npm run --workspace packages/language build",
        "build:extension": "npm run --workspace packages/extension build",
        "build:interpreter": "npm run --workspace packages/interpreter build",
        "build:cli": "npm run --workspace packages/cli build",
        "build:all": "npm run build:language && npm run build:interpreter && npm run build:extension && npm run build:cli",
        "test:language": "npm run --workspace packages/language test",
        "test:extension": "npm run --workspace packages/extension test",
        "test:interpreter": "npm run --workspace packages/interpreter test",
        "test:all": "npm run test:language && npm run test:extension && npm run test:interpreter",
        "pack": "npm run --workspace packages/extension pack"
    },
    "devDependencies": {
        "@types/node": "~20.17.48",
        "shx": "~0.4.0",
        "typescript": "~5.8.3"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    },
    "workspaces": [
        "packages/*"
    ]
}
