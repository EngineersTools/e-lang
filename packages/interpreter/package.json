{
    "name": "e-lang-interpreter",
    "description": "Interpreter for the e-lang programming language",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc -b tsconfig.json",
        "build:clean": "npm run clean && npm run build",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "e-lang-language": "0.0.1"
    },
    "devDependencies": {
        "shx": "^0.3.4",
        "typescript": "~5.6.2",
        "vitest": "~3.1.3"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    }
}
