{
    "name": "vscode-e-lang",
    "description": "The extension specific package",
    "version": "0.1.0",
    "displayName": "e-lang",
    "type": "module",
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "e-lang",
                "aliases": [
                    "ELang",
                    "e-lang"
                ],
                "extensions": [
                    ".elng"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "e-lang",
                "scopeName": "source.e-lang",
                "path": "syntaxes/e-lang.tmLanguage.json"
            }
        ],
        "notebooks": [
            {
                "type": "e-lang-notebook",
                "displayName": "E-Lang Notebook",
                "selector": [
                    {
                        "filenamePattern": "*.elnb"
                    }
                ]
            }
        ]
    },
    "activationEvents": [
        "onLanguage:e-lang",
        "onNotebook:e-lang-notebook"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build && npm run --include-workspace-root --workspace=../.. lint",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/e-lang.tmLanguage.json ./syntaxes/e-lang.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
        "test": "npm run build && npm run test-compile && npm run test-integration",
        "test-compile": "tsc -p tsconfig.test.json",
        "test-integration": "node out/src/test/runTest.cjs"
    },
    "dependencies": {
        "e-lang-language": "0.1.0",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@types/glob": "^7.2.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.96.0",
        "@vscode/test-electron": "^2.5.2",
        "concurrently": "~8.2.1",
        "esbuild": "~0.25.5",
        "glob": "^7.2.3",
        "mocha": "^11.7.5"
    },
    "vsce": {
        "dependencies": false
    }
}
