{
    "name": "e-lang-language",
    "description": "The language specific package",
    "version": "0.1.5",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "tsc -b tsconfig.json",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "langium": "^4.1.3",
        "typir": "^0.3.0",
        "typir-langium": "^0.3.0"
    },
    "devDependencies": {
        "langium-cli": "^4.0.0",
        "vitest": "~3.1.4"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    }
}
